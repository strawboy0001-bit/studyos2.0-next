# ==============================================================================
# STUDYOS 2.0 — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env.local' and supply your project credentials:
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION URL & HOSTING
# ------------------------------------------------------------------------------
# In local development: http://localhost:3000
# In production on Vercel: https://your-studyos-domain.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. GOOGLE OAUTH 2.0 AUTHENTICATION
# ------------------------------------------------------------------------------
# Create an OAuth 2.0 Web Application client in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
#
# 1. Authorized JavaScript Origins:
#    - http://localhost:3000
#    - https://your-studyos-domain.vercel.app
#
# 2. Authorized Redirect URIs:
#    - http://localhost:3000/api/auth/callback/google
#    - https://your-studyos-domain.vercel.app/api/auth/callback/google
#
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# ------------------------------------------------------------------------------
# 3. AI PROVIDER INTEGRATIONS (OPTIONAL)
# ------------------------------------------------------------------------------
# StudyOS functions offline with local heuristic generation by default.
# Supply one of the keys below to enable cloud LLM synthesis:

# Google AI Studio (Gemini 1.5 Flash / Pro): https://aistudio.google.com/
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# OpenAI Platform (GPT-4o / GPT-4o-mini): https://platform.openai.com/
OPENAI_API_KEY="sk-proj-YourOpenAIApiKeyHere"

# Local Ollama endpoint (if running Ollama locally):
OLLAMA_ENDPOINT="http://localhost:11434"
